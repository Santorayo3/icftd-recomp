/* The Windows build's own resource: the application icon and the version page Explorer shows.
 *
 * Compiled by tools\build-host.ps1 (Open Watcom wrc) into bin\win32\res\icftd.res, which is linked
 * in with the objects. The icon itself is not tracked: tools\mkappicon.ps1 makes it from
 * assets\app_icon.png, and the file is passed to wrc through -i=bin\win32\res.
 *
 * Nothing here is decoded from the game's disks - the icon is the port's own artwork and the
 * strings are the port's own - so a release carries it whether or not the player has the disks.
 *
 * The name is the game's, because that is what the window list, Explorer and the taskbar show;
 * OriginalFilename matches the executable tools\win32-pack.ps1 stages in bin\win32\game.
 */

#include <winver.h>

1 ICON "icftd.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Tim Rachor"
            VALUE "FileDescription",  "It Came from the Desert"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "It Came from the Desert"
            VALUE "LegalCopyright",   "Copyright © 2026 Tim Rachor"
            VALUE "OriginalFilename", "It Came from the Desert.exe"
            VALUE "ProductName",      "It Came from the Desert"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
