# ---------------------------------------------------------------- game data --
# "It Came from the Desert" is copyrighted. Nothing that is game artwork, that
# contains it, or that was decoded from it may be committed.

# Original Amiga floppy images - the user has to supply these.
/disks/*
!/disks/README.md

# Everything decoded from the images: extracted filesystems, PNG previews and
# the runtime pack.  Rebuilt from disks\ by tools\extract.ps1 and tools\gamepack.ps1;
# the port's own PNGs (below) are the opposite - authored here and tracked.
/assets/*
!/assets/README.md
!/assets/autosave.png
!/assets/titlescreen.png
!/assets/crosshair.png
!/assets/border.png
!/assets/btn_normal.png
!/assets/btn_hover.png
!/assets/portrait_box.png
!/assets/quit_confirm.png
!/assets/plus_hover.png
!/assets/plus_normal.png
!/assets/minus_hover.png
!/assets/minus_normal.png
!/assets/toggle_off.png
!/assets/toggle_on.png
# The Windows executable's icon (tools\mkappicon.ps1) - the port's own artwork, shipped in the binary.
!/assets/app_icon.png
/export/

# WinUAE reference captures of the original game.
/ref/

# Ghidra project, decompiled C and disassembly - derived from the game program.
/re/

# ------------------------------------------------------------- build output --
bin/
obj/
*.obj
*.exe
*.pdb
*.ilk
*.map
*.bmp
*.ppm
out/

# Player settings: the game writes icftd.ini with its defaults on the first start
# (src\runtime\config.c), so it is local state, not part of the project.
/icftd.ini
# Generated by tools\make-winuae-config.ps1; holds absolute paths of this machine.
/tools/icftd.uae

# Belt and braces: the data formats, wherever they end up.
*.adf
*.ipf
*.art
*.pak
*.idx8

# ---------------------------------------------------------- editor and OS ----
.vs/
.vscode/
*.user
*.swp
Thumbs.db
.DS_Store

# Watcom scratch and the Musashi opcode generator binary
__wcl_*.lnk
third_party/musashi/m68kmake.exe

# Reference checkouts (WinUAE etc.) are read, never vendored: only the routines we adapt get
# copied into our own sources with attribution.
third_party/reference/

# The generated translation files: en.csv is the game's own script, a *.work.csv has the English
# column in it, and an older tab-separated file is not read any more. The translations themselves
# (lang\<code>.csv, keyed by an id, one file per language) ARE committed - see lang/README.md.
/lang/*.txt
/lang/*.work.csv
/lang/en.csv
/lang/en_ant.csv
!/lang/README.md

