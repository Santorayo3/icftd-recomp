; ICFTD reference: A500, OCS, 1MB chip, Cycle-exact (Full). Nothing is loaded into the emulator:
; WinUAE calls a Lua handler from inside vsync_handler_post() (custom.cpp), in the middle of the
; machine's own frame logic, and every run that had a script in it came back with a glitched
; picture. The instrument lives outside the emulator now (our own --framelog, and see
; docs\next-session.md for what the reference numbers derived from Lua were worth: nothing).
;
; statefile_quit: closing the window writes the complete machine state to that file - RAM included -
; without a Lua script and without a keypress timed to a frame (custom.cpp:6576, on UAE_QUIT).
; That is the only way to compare the reference's memory with ours byte for byte; the phase does not
; have to be frame-precise, because the dumps are matched by *content*, not by frame number.
;   winuae64.exe "tools\icftd-reference.uae"
config_description=ICFTD reference (A500, OCS, 1MB) - cycle-exact, no Lua
use_gui=no
statefile_quit=E:\Meine Programme\Unity\Projects\icftd-recomp\out\ref-quit.uss
kickstart_rom_file=C:\Users\Public\Documents\Amiga Files\WinUAE\KICK13.ROM
cpu_type=68000
cpu_model=68000
cpu_compatible=true
cpu_24bit_addressing=true
cpu_speed=real
cpu_cycle_exact=true
cpu_memory_cycle_exact=true
cycle_exact=cpu
blitter_cycle_exact=true
copper_cycle_exact=true
immediate_blits=false
waiting_blits=automatic
chipset=ocs
chipset_compatible=A500
chipmem_size=1
bogomem_size=2
fastmem_size=0
z3mem_size=0
collision_level=playfields
gfx_framerate=1
gfx_fullscreen_amiga=false
gfx_display=0
gfx_display_rtg=0
gfx_width=320
gfx_height=256
gfx_width_windowed=320
gfx_height_windowed=256
gfx_x_windowed=200
gfx_y_windowed=150
gfx_correct_aspect=false
window_statusbar=false
sound_output=exact
sound_channels=stereo
sound_frequency=44100
sound_interpol=anti
joyport0=mouse
joyport1=none
floppy_speed=800
floppy0type=0
floppy0=E:\Meine Programme\Unity\Projects\icftd-recomp\disks\It Came from the Desert (1989)(Cinemaware)(Disk 1 of 3)[!].adf
floppy1type=0
floppy1=E:\Meine Programme\Unity\Projects\icftd-recomp\disks\It Came from the Desert (1989)(Cinemaware)(Disk 2 of 3)[!].adf
floppy2type=0
floppy2=E:\Meine Programme\Unity\Projects\icftd-recomp\disks\It Came from the Desert (1989)(Cinemaware)(Disk 3 of 3)[!].adf
floppy3type=-1
